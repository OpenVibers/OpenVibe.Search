# ═══════════════════════════════════════════════════════════════
# OpenVibe.Search — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/search.env (0600); the systemd unit sets
# NODE_ENV, PORT and SEARCH_DB_PATH itself.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4710
HOST=127.0.0.1
NODE_ENV=development
#BASE_URL=https://search.openvibe.network

# Identity — OpenVibe.Network signs service tokens (client_credentials, audience
# openvibe.search) and user JWTs. The public key is fetched from
# <url>/api/.well-known/jwks (internal URL first), retried every 30 s until it loads.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
#OV_NETWORK_ISSUER=https://openvibe.network
# Pin the key instead of fetching it (PEM; \n escapes allowed).
#OV_NETWORK_PUBLIC_KEY=
# A browser's user JWT is accepted when its aud contains one of these.
#SEARCH_USER_AUDIENCES=openvibe.search,openvibe.network

# This service's own principal (svc:search) — publishes search.document.* to Events
# (events.event.publish) and creates its subscription (events.subscription.manage).
OV_OAUTH_CLIENT_ID=search
OV_OAUTH_CLIENT_SECRET=

# Store (SQLite, FTS5). Production: /var/lib/openvibe-search/search.db (systemd StateDirectory).
SEARCH_DB_PATH=./data/search.db

# OpenVibe.Events. The outbox relay runs only when EVENTS_URL is set.
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000
# Signing secret(s) of the index-document subscription (comma-separated during rotation).
# Generate before `npm run subscribe`, e.g. `openssl rand -hex 32`. Unset = webhook off (503).
#SEARCH_EVENTS_SECRET=
# Sources whose <source>.index_document.* events are accepted (default: wiki blog news reviews
# deals coupons trade community live media codes games tools sources).
#SEARCH_EVENT_OWNERS=wiki,blog,news

# Largest accepted request body (direct PUT and deliveries), bytes.
#SEARCH_MAX_BODY_BYTES=262144

# Ranking: freshness weighting of full-text relevance (README "Ranking").
#   score = bm25 × (1 + WEIGHT × 2^(−age_days / HALF_LIFE_DAYS)); age from published_at, else
#   updated_at. WEIGHT 0 turns it off.
#SEARCH_FRESHNESS_WEIGHT=1
#SEARCH_FRESHNESS_HALF_LIFE_DAYS=30

# Saved searches per signed-in person.
#SEARCH_SAVED_MAX_PER_SUBJECT=50

# Removal purge queue (README "Removals, caches and the CDN"). Every removal is recorded for
# its owner (GET /api/v1/owners/:owner/removals). The Cloudflare purge of a formerly public URL
# runs only when CLOUDFLARE_PURGE_TOKEN is set (inert otherwise). The token needs only
# Zone → Cache Purge → Purge on the zones below. Never commit it: /etc/openvibe/search.env (0600).
#CLOUDFLARE_PURGE_TOKEN=
# host=zone id pairs; a URL uses the zone of its host or nearest parent domain.
#CLOUDFLARE_ZONE_IDS=openvibe.wiki=<zone id>,openvibe.blog=<zone id>,openvibe.network=<zone id>
# Paths on the removed URL's host purged with it (default /sitemap.xml; `none` for none).
#CLOUDFLARE_PURGE_RELATED_PATHS=/sitemap.xml,/feed.atom,/feed.json
#CLOUDFLARE_PURGE_INTERVAL_MS=5000
